# Microsoft Entra ID app registration (client credentials flow)
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-app-registration-client-secret

# Single-tenant mode (use AZURE_TENANT_ID OR INTUNE_CLIENTS, not both).
AZURE_TENANT_ID=your-tenant-id

# Multi-tenant mode. Overrides AZURE_TENANT_ID. Comma-separated key:tenantId
# pairs. Each `key` must match ^[a-zA-Z0-9_.-]{1,64}$ and is passed as the
# `client` argument to any tool. Requires a multi-tenant app registration
# and admin consent in each customer tenant.
# INTUNE_CLIENTS=acme:00000000-0000-0000-0000-000000000001,contoso:00000000-0000-0000-0000-000000000002

# Optional. Defaults to Microsoft Graph global cloud.
# Override for sovereign clouds (e.g. https://graph.microsoft.us, https://microsoftgraph.chinacloudapi.cn).
# GRAPH_BASE_URL=https://graph.microsoft.com

# Optional. Defaults to v1.0. Set to "beta" if you need preview endpoints.
# GRAPH_API_VERSION=v1.0

# Optional. Defaults to the global Microsoft identity endpoint.
# Override for sovereign clouds (e.g. https://login.microsoftonline.us).
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com

# Optional. Stdio (default) or http.
# INTUNE_TRANSPORT=stdio

# Optional. Port for the streamable HTTP transport.
# PORT=3000

# Optional. Hard cap (bytes) for a single tool response payload before it is truncated. Default 200000.
# INTUNE_MAX_RESPONSE_BYTES=200000
